# The base URL of your https://github.com/sysnocs/wapanel instance (no trailing slash).
https://github.com/sysnocs/wapanel_BASE_URL=https://your-crm.example.com

# A https://github.com/sysnocs/wapanel API key. Create one in the dashboard:
#   Settings → API keys → New API key.
# The key's scopes decide what the server can do — grant the minimum.
https://github.com/sysnocs/wapanel_API_KEY=https://github.com/sysnocs/wapanel_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Write guards (opt-in) ------------------------------------------
# By default the server is READ-ONLY: it never exposes tools that
# change data or send messages, no matter what the API key allows.
# Turn these on deliberately.

# Expose contact create/update and single-message sending.
# https://github.com/sysnocs/wapanel_ENABLE_WRITES=true

# Expose the broadcast tool (mass sends — highest risk). Requires
# https://github.com/sysnocs/wapanel_ENABLE_WRITES as well.
# https://github.com/sysnocs/wapanel_ENABLE_BROADCASTS=true
